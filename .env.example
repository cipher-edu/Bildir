# ── Backend ──────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=your-jwt-secret-here
# RS256 uchun (production):
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem

# Database (default: SQLite — o'rnatma kerak emas)
# PostgreSQL kerak bo'lsa:
# POSTGRES_DB=hemis_auth
# POSTGRES_USER=db_user
# POSTGRES_PASSWORD=db_pass
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# HEMIS
HEMIS_MOCK_MODE=True
HEMIS_API_BASE_URL=https://student.nspi.uz/rest
HEMIS_BACKEND_TOKEN=

HEMIS_OAUTH_CLIENT_ID=
HEMIS_OAUTH_CLIENT_SECRET=
HEMIS_OAUTH_BASE_URL=https://hemis.nspi.uz
HEMIS_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/callback/

HEMIS_STUDENT_OAUTH_BASE_URL=https://student.nspi.uz
HEMIS_STUDENT_OAUTH_CLIENT_ID=
HEMIS_STUDENT_OAUTH_CLIENT_SECRET=

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
