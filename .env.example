# ══════════════════════════════════════════════════════════════
# Bildir — Docker Compose / lokal env
# Nusxa:  cp .env.example .env
# Repo:   https://github.com/cipher-edu/Bildir
# ══════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.production

# JWT (access default 15 daqiqa — logout oynasini kichiklashtirish)
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_COOKIE_SAMESITE=Lax
# localhost HTTP da Chrome Secure cookie ni qabul qiladi. Boshqa HTTP hostda false.
JWT_COOKIE_SECURE=true

# So'rovnoma / anonim xabar shifri. Productionda majburiy. SECRET_KEY dan olinmaydi.
SURVEY_ENCRYPTION_KEY=replace-with-a-long-random-string
SURVEY_HMAC_KEY=replace-with-a-long-random-string
SURVEY_TOKEN_KEY=replace-with-a-long-random-string
WHISTLE_ENCRYPTION_KEY=replace-with-a-long-random-string
# Birinchi migratsiyadan keyin o'chiring. Eski javoblarni ochish uchun oldingi DJANGO_SECRET_KEY.
SURVEY_LEGACY_SECRET=

# ── Rate limiting (brute-force himoya) ───────────────────────
THROTTLE_ANON=120/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_LOGIN_ACCOUNT=20/hour
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_FORGOT_PASSWORD=5/hour
THROTTLE_WHISTLE=30/hour

# ── PostgreSQL (Docker: host=db) ──────────────────────────────
POSTGRES_DB=auth_starter
POSTGRES_USER=auth
POSTGRES_PASSWORD=replace-with-a-long-random-string
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-long-random-hex
REDIS_URL=redis://:replace-with-the-same-hex@redis:6379/1
REDIS_TIMER_URL=redis://:replace-with-the-same-hex@redis:6379/5
WAIT_FOR_REDIS=true

# ── Superadmin (yo'q bo'lsa yaratiladi; mavjud parol qayta yozilmaydi) ─
SUPERUSER_EMAIL=superadmin@ndu.uz
SUPERUSER_PASSWORD=replace-with-a-long-random-string
SUPERUSER_FIRST_NAME=Super
SUPERUSER_LAST_NAME=Admin

# ── CORS / Frontend ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Brauzer: same-origin /api/v1 → Next rewrite → backend
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── HEMIS ─────────────────────────────────────────────────────
HEMIS_MOCK_MODE=False
HEMIS_API_BASE_URL=https://student.nspi.uz/rest
HEMIS_BACKEND_TOKEN=
HEMIS_OAUTH_CLIENT_ID=6
HEMIS_OAUTH_CLIENT_SECRET=
HEMIS_OAUTH_BASE_URL=https://hemis.nspi.uz
HEMIS_STUDENT_OAUTH_BASE_URL=https://student.nspi.uz
HEMIS_STUDENT_OAUTH_CLIENT_ID=
HEMIS_STUDENT_OAUTH_CLIENT_SECRET=
HEMIS_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/callback/
